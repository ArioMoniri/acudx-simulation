{
 "rows": [
  {
   "lang": "tr",
   "chars": 25,
   "text": "Dün akşam başladı doktor,",
   "first_audio_s": 0.656,
   "total_s": 1.623,
   "audio_s": 2.1,
   "max_gap_s": 0.0,
   "pieces": 12
  },
  {
   "lang": "tr",
   "chars": 25,
   "text": "Göğsümde bir sıkışma var,",
   "first_audio_s": 0.679,
   "total_s": 1.742,
   "audio_s": 2.3,
   "max_gap_s": 0.0,
   "pieces": 11
  },
  {
   "lang": "tr",
   "chars": 56,
   "text": "Nefes almakta zorlanıyorum, özellikle merdiven çıkarken.",
   "first_audio_s": 0.649,
   "total_s": 3.642,
   "audio_s": 5.44,
   "max_gap_s": 0.0,
   "pieces": 27
  },
  {
   "lang": "tr",
   "chars": 17,
   "text": "Hayır doktor bey,",
   "first_audio_s": 0.627,
   "total_s": 1.646,
   "audio_s": 2.14,
   "max_gap_s": 0.0,
   "pieces": 11
  },
  {
   "lang": "tr",
   "chars": 47,
   "text": "Sabahtan beri midem bulanıyor ve başım dönüyor.",
   "first_audio_s": 0.656,
   "total_s": 1.945,
   "audio_s": 3.02,
   "max_gap_s": 0.0,
   "pieces": 15
  },
  {
   "lang": "tr",
   "chars": 49,
   "text": "Düzenli kullandığım bir ilaç yok, alerjim de yok.",
   "first_audio_s": 0.659,
   "total_s": 3.982,
   "audio_s": 6.36,
   "max_gap_s": 0.0,
   "pieces": 31
  },
  {
   "lang": "en",
   "chars": 30,
   "text": "It started last night, doctor.",
   "first_audio_s": 0.635,
   "total_s": 1.922,
   "audio_s": 3.02,
   "max_gap_s": 0.0,
   "pieces": 15
  },
  {
   "lang": "en",
   "chars": 48,
   "text": "I feel a tight pressure in my chest when I walk.",
