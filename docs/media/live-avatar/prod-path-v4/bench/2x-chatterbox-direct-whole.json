{
 "rows": [
  {
   "lang": "tr",
   "chars": 25,
   "text": "Dün akşam başladı doktor,",
   "first_audio_s": 1.527,
   "total_s": 1.58,
   "audio_s": 3.3,
   "max_gap_s": 0.0,
   "pieces": 16
  },
  {
   "lang": "tr",
   "chars": 25,
   "text": "Göğsümde bir sıkışma var,",
   "first_audio_s": 1.241,
   "total_s": 1.279,
   "audio_s": 2.46,
   "max_gap_s": 0.0,
   "pieces": 11
  },
  {
   "lang": "tr",
   "chars": 56,
   "text": "Nefes almakta zorlanıyorum, özellikle merdiven çıkarken.",
   "first_audio_s": 1.163,
   "total_s": 3.008,
   "audio_s": 6.2,
   "max_gap_s": 0.0,
   "pieces": 29
  },
  {
   "lang": "tr",
   "chars": 17,
   "text": "Hayır doktor bey,",
   "first_audio_s": 1.158,
   "total_s": 1.2,
   "audio_s": 2.22,
   "max_gap_s": 0.0,
   "pieces": 11
  },
  {
   "lang": "tr",
   "chars": 47,
   "text": "Sabahtan beri midem bulanıyor ve başım dönüyor.",
   "first_audio_s": 1.457,
   "total_s": 1.497,
   "audio_s": 3.22,
   "max_gap_s": 0.0,
   "pieces": 15
  },
  {
   "lang": "tr",
   "chars": 49,
   "text": "Düzenli kullandığım bir ilaç yok, alerjim de yok.",
   "first_audio_s": 1.4,
   "total_s": 2.73,
   "audio_s": 5.8,
   "max_gap_s": 0.0,
   "pieces": 27
  },
  {
   "lang": "en",
   "chars": 30,
   "text": "It started last night, doctor.",
   "first_audio_s": 1.227,
   "total_s": 1.265,
   "audio_s": 2.5,
   "max_gap_s": 0.0,
   "pieces": 12
  },
  {
   "lang": "en",
   "chars": 48,
   "text": "I feel a tight pressure in my chest when I walk.",
