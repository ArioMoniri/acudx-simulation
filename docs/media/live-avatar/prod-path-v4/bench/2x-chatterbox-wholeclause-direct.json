 "rows": [
  {
   "lang": "tr",
   "chars": 25,
   "text": "Dün akşam başladı doktor,",
   "first_audio_s": 1.043,
   "total_s": 1.284,
   "audio_s": 1.98,
   "max_gap_s": 0.0,
   "pieces": 10
  },
  {
   "lang": "tr",
   "chars": 25,
   "text": "Göğsümde bir sıkışma var,",
   "first_audio_s": 1.382,
   "total_s": 1.444,
   "audio_s": 3.02,
   "max_gap_s": 0.0,
   "pieces": 14
  },
  {
   "lang": "tr",
   "chars": 56,
   "text": "Nefes almakta zorlanıyorum, özellikle merdiven çıkarken.",
   "first_audio_s": 1.103,
   "total_s": 3.11,
   "audio_s": 6.48,
   "max_gap_s": 0.0,
   "pieces": 31
  },
  {
   "lang": "tr",
   "chars": 17,
   "text": "Hayır doktor bey,",
   "first_audio_s": 0.819,
   "total_s": 0.841,
   "audio_s": 1.3,
   "max_gap_s": 0.0,
   "pieces": 6
  },
  {
   "lang": "tr",
   "chars": 47,
   "text": "Sabahtan beri midem bulanıyor ve başım dönüyor.",
   "first_audio_s": 2.071,
   "total_s": 2.155,
   "audio_s": 5.14,
   "max_gap_s": 0.0,
   "pieces": 23
  },
  {
   "lang": "tr",
   "chars": 49,
   "text": "Düzenli kullandığım bir ilaç yok, alerjim de yok.",
   "first_audio_s": 1.197,
   "total_s": 2.057,
   "audio_s": 3.84,
   "max_gap_s": 0.0,
   "pieces": 18
  },
  {
   "lang": "en",
   "chars": 30,
   "text": "It started last night, doctor.",
   "first_audio_s": 1.014,
   "total_s": 1.057,
   "audio_s": 1.82,
   "max_gap_s": 0.0,
   "pieces": 9
  },
