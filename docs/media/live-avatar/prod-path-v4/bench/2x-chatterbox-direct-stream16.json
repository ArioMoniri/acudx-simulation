{
 "rows": [
  {
   "lang": "tr",
   "chars": 25,
   "text": "Dün akşam başladı doktor,",
   "first_audio_s": 0.584,
   "total_s": 2.611,
   "audio_s": 3.98,
   "max_gap_s": 0.247,
   "pieces": 22
  },
  {
   "lang": "tr",
   "chars": 25,
   "text": "Göğsümde bir sıkışma var,",
   "first_audio_s": 0.523,
   "total_s": 1.468,
   "audio_s": 1.74,
   "max_gap_s": 0.241,
   "pieces": 10
  },
  {
   "lang": "tr",
   "chars": 56,
   "text": "Nefes almakta zorlanıyorum, özellikle merdiven çıkarken.",
   "first_audio_s": 0.534,
   "total_s": 3.995,
   "audio_s": 5.72,
   "max_gap_s": 0.233,
   "pieces": 30
  },
  {
   "lang": "tr",
   "chars": 17,
   "text": "Hayır doktor bey,",
   "first_audio_s": 0.58,
   "total_s": 1.19,
   "audio_s": 1.26,
   "max_gap_s": 0.229,
   "pieces": 7
  },
  {
   "lang": "tr",
   "chars": 47,
   "text": "Sabahtan beri midem bulanıyor ve başım dönüyor.",
   "first_audio_s": 0.541,
   "total_s": 2.062,
   "audio_s": 3.18,
   "max_gap_s": 0.263,
   "pieces": 16
  },
  {
   "lang": "tr",
   "chars": 49,
   "text": "Düzenli kullandığım bir ilaç yok, alerjim de yok.",
   "first_audio_s": 0.546,
   "total_s": 2.854,
   "audio_s": 3.88,
   "max_gap_s": 0.238,
   "pieces": 20
  },
  {
   "lang": "en",
   "chars": 30,
   "text": "It started last night, doctor.",
   "first_audio_s": 0.552,
   "total_s": 1.516,
   "audio_s": 1.7,
   "max_gap_s": 0.244,
   "pieces": 9
  },
  {
   "lang": "en",
   "chars": 48,
