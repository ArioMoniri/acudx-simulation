{
 "rows": [
  {
   "lang": "tr",
   "chars": 25,
   "text": "Dün akşam başladı doktor,",
   "first_audio_s": 0.978,
   "total_s": 4.065,
   "audio_s": 3.66,
   "max_gap_s": 1.441,
   "pieces": 18
  },
  {
   "lang": "tr",
   "chars": 25,
   "text": "Göğsümde bir sıkışma var,",
   "first_audio_s": 0.998,
   "total_s": 3.885,
   "audio_s": 3.3,
   "max_gap_s": 1.241,
   "pieces": 16
  },
  {
   "lang": "tr",
   "chars": 56,
   "text": "Nefes almakta zorlanıyorum, özellikle merdiven çıkarken.",
   "first_audio_s": 0.938,
   "total_s": 7.673,
   "audio_s": 6.28,
   "max_gap_s": 1.519,
   "pieces": 31
  },
  {
   "lang": "tr",
   "chars": 17,
   "text": "Hayır doktor bey,",
   "first_audio_s": 0.943,
   "total_s": 3.572,
   "audio_s": 3.02,
   "max_gap_s": 0.985,
   "pieces": 15
  },
  {
   "lang": "tr",
   "chars": 47,
   "text": "Sabahtan beri midem bulanıyor ve başım dönüyor.",
   "first_audio_s": 0.953,
   "total_s": 5.031,
   "audio_s": 4.46,
   "max_gap_s": 1.428,
   "pieces": 22
  },
  {
   "lang": "tr",
   "chars": 49,
   "text": "Düzenli kullandığım bir ilaç yok, alerjim de yok.",
   "first_audio_s": 0.977,
   "total_s": 6.834,
   "audio_s": 5.72,
   "max_gap_s": 1.436,
   "pieces": 28
  },
  {
   "lang": "en",
   "chars": 30,
   "text": "It started last night, doctor.",
   "first_audio_s": 0.971,
   "total_s": 2.797,
   "audio_s": 1.9,
   "max_gap_s": 0.991,
   "pieces": 10
  },
  {
   "lang": "en",
   "chars": 48,
   "text": "I feel a tight pressure in my chest when I walk.",
