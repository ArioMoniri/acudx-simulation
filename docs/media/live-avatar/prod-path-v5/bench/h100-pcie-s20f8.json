{
 "rows": [
  {
   "lang": "tr",
   "chars": 25,
   "text": "Dün akşam başladı doktor,",
   "first_audio_s": 1.388,
   "total_s": 3.454,
   "audio_s": 1.9,
   "max_gap_s": 0.778,
   "pieces": 12
  },
  {
   "lang": "tr",
   "chars": 25,
   "text": "Göğsümde bir sıkışma var,",
   "first_audio_s": 1.143,
   "total_s": 3.925,
   "audio_s": 3.98,
   "max_gap_s": 0.902,
   "pieces": 20
  },
  {
   "lang": "tr",
   "chars": 56,
   "text": "Nefes almakta zorlanıyorum, özellikle merdiven çıkarken.",
   "first_audio_s": 1.45,
   "total_s": 9.118,
   "audio_s": 5.88,
   "max_gap_s": 3.445,
   "pieces": 31
  },
  {
   "lang": "tr",
   "chars": 17,
   "text": "Hayır doktor bey,",
   "first_audio_s": 0.919,
   "total_s": 3.157,
   "audio_s": 3.02,
   "max_gap_s": 0.71,
   "pieces": 16
  },
  {
   "lang": "tr",
   "chars": 47,
   "text": "Sabahtan beri midem bulanıyor ve başım dönüyor.",
   "first_audio_s": 0.918,
   "total_s": 3.089,
   "audio_s": 2.86,
   "max_gap_s": 0.613,
   "pieces": 15
  },
  {
   "lang": "tr",
   "chars": 49,
   "text": "Düzenli kullandığım bir ilaç yok, alerjim de yok.",
   "first_audio_s": 0.993,
   "total_s": 5.585,
   "audio_s": 5.8,
   "max_gap_s": 0.575,
   "pieces": 30
  },
  {
   "lang": "en",
   "chars": 30,
   "text": "It started last night, doctor.",
   "first_audio_s": 1.356,
   "total_s": 3.949,
   "audio_s": 2.7,
   "max_gap_s": 1.064,
   "pieces": 14
  },
  {
   "lang": "en",
   "chars": 48,
   "text": "I feel a tight pressure in my chest when I walk.",
   "first_audio_s": 1.346,
   "total_s": 5.891,
   "audio_s": 3.28,
   "max_gap_s": 1.923,
   "pieces": 17
  }
 ],
