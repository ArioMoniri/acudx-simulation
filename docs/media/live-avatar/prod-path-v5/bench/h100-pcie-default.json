{
 "rows": [
  {
   "lang": "tr",
   "chars": 25,
   "text": "Dün akşam başladı doktor,",
   "first_audio_s": 1.497,
   "total_s": 3.224,
   "audio_s": 1.82,
   "max_gap_s": 0.972,
   "pieces": 10
  },
  {
   "lang": "tr",
   "chars": 25,
   "text": "Göğsümde bir sıkışma var,",
   "first_audio_s": 1.557,
   "total_s": 4.549,
   "audio_s": 2.9,
   "max_gap_s": 1.276,
   "pieces": 14
  },
  {
   "lang": "tr",
   "chars": 56,
   "text": "Nefes almakta zorlanıyorum, özellikle merdiven çıkarken.",
   "first_audio_s": 1.15,
   "total_s": 6.178,
   "audio_s": 4.04,
   "max_gap_s": 2.095,
   "pieces": 20
  },
  {
   "lang": "tr",
   "chars": 17,
   "text": "Hayır doktor bey,",
   "first_audio_s": 1.595,
   "total_s": 4.792,
   "audio_s": 3.02,
   "max_gap_s": 1.482,
   "pieces": 15
  },
  {
   "lang": "tr",
   "chars": 47,
   "text": "Sabahtan beri midem bulanıyor ve başım dönüyor.",
   "first_audio_s": 1.8,
   "total_s": 5.326,
   "audio_s": 3.1,
   "max_gap_s": 1.809,
   "pieces": 16
  },
  {
   "lang": "tr",
   "chars": 49,
   "text": "Düzenli kullandığım bir ilaç yok, alerjim de yok.",
   "first_audio_s": 1.316,
   "total_s": 9.396,
   "audio_s": 7.28,
   "max_gap_s": 2.216,
   "pieces": 36
  },
  {
   "lang": "en",
   "chars": 30,
   "text": "It started last night, doctor.",
   "first_audio_s": 1.551,
   "total_s": 4.534,
   "audio_s": 2.74,
   "max_gap_s": 1.268,
   "pieces": 14
  },
  {
   "lang": "en",
   "chars": 48,
   "text": "I feel a tight pressure in my chest when I walk.",
   "first_audio_s": 1.641,
   "total_s": 5.644,
   "audio_s": 3.04,
   "max_gap_s": 1.449,
   "pieces": 16
  }
 ],
