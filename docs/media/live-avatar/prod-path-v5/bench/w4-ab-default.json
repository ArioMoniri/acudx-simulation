{
 "rows": [
  {
   "lang": "tr",
   "chars": 25,
   "text": "Dün akşam başladı doktor,",
   "first_audio_s": 1.147,
   "total_s": 2.84,
   "audio_s": 1.9,
   "max_gap_s": 0.454,
   "pieces": 11
  },
  {
   "lang": "tr",
   "chars": 25,
   "text": "Göğsümde bir sıkışma var,",
   "first_audio_s": 1.16,
   "total_s": 3.289,
   "audio_s": 2.58,
   "max_gap_s": 0.488,
   "pieces": 13
  },
  {
   "lang": "tr",
   "chars": 56,
   "text": "Nefes almakta zorlanıyorum, özellikle merdiven çıkarken.",
   "first_audio_s": 1.16,
   "total_s": 5.874,
   "audio_s": 4.2,
   "max_gap_s": 1.314,
   "pieces": 21
  },
  {
   "lang": "tr",
   "chars": 17,
   "text": "Hayır doktor bey,",
   "first_audio_s": 1.169,
   "total_s": 3.589,
   "audio_s": 2.94,
   "max_gap_s": 0.778,
   "pieces": 14
  },
  {
   "lang": "tr",
   "chars": 47,
   "text": "Sabahtan beri midem bulanıyor ve başım dönüyor.",
   "first_audio_s": 1.167,
   "total_s": 4.135,
   "audio_s": 3.66,
   "max_gap_s": 1.345,
   "pieces": 17
  },
  {
   "lang": "tr",
   "chars": 49,
   "text": "Düzenli kullandığım bir ilaç yok, alerjim de yok.",
   "first_audio_s": 1.18,
   "total_s": 7.316,
   "audio_s": 6.36,
   "max_gap_s": 1.135,
   "pieces": 31
  },
  {
   "lang": "en",
   "chars": 30,
   "text": "It started last night, doctor.",
   "first_audio_s": 1.158,
   "total_s": 2.811,
   "audio_s": 1.9,
   "max_gap_s": 0.465,
   "pieces": 10
  },
