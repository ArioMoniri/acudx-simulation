{
 "rows": [
  {
   "lang": "tr",
   "chars": 25,
   "text": "Dün akşam başladı doktor,",
   "first_audio_s": 0.984,
   "total_s": 2.72,
   "audio_s": 2.14,
   "max_gap_s": 0.541,
   "pieces": 11
  },
  {
   "lang": "tr",
   "chars": 25,
   "text": "Göğsümde bir sıkışma var,",
   "first_audio_s": 0.959,
   "total_s": 3.469,
   "audio_s": 3.18,
   "max_gap_s": 1.033,
   "pieces": 16
  },
  {
   "lang": "tr",
   "chars": 56,
   "text": "Nefes almakta zorlanıyorum, özellikle merdiven çıkarken.",
   "first_audio_s": 0.974,
   "total_s": 5.383,
   "audio_s": 4.28,
   "max_gap_s": 1.068,
   "pieces": 23
  },
  {
   "lang": "tr",
   "chars": 17,
   "text": "Hayır doktor bey,",
   "first_audio_s": 0.972,
   "total_s": 1.814,
   "audio_s": 1.34,
   "max_gap_s": 0.341,
   "pieces": 8
  },
  {
   "lang": "tr",
   "chars": 47,
   "text": "Sabahtan beri midem bulanıyor ve başım dönüyor.",
   "first_audio_s": 0.989,
   "total_s": 3.462,
   "audio_s": 3.26,
   "max_gap_s": 0.994,
   "pieces": 17
  },
  {
   "lang": "tr",
   "chars": 49,
   "text": "Düzenli kullandığım bir ilaç yok, alerjim de yok.",
   "first_audio_s": 0.969,
   "total_s": 6.38,
   "audio_s": 5.72,
   "max_gap_s": 0.971,
   "pieces": 30
  },
  {
   "lang": "en",
   "chars": 30,
   "text": "It started last night, doctor.",
   "first_audio_s": 0.986,
   "total_s": 3.319,
   "audio_s": 3.02,
   "max_gap_s": 0.861,
   "pieces": 16
  },
  {
   "lang": "en",
   "chars": 48,
   "text": "I feel a tight pressure in my chest when I walk.",
