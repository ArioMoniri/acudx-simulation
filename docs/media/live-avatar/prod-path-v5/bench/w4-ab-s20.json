{
 "rows": [
  {
   "lang": "tr",
   "chars": 25,
   "text": "Dün akşam başladı doktor,",
   "first_audio_s": 1.082,
   "total_s": 4.084,
   "audio_s": 3.7,
   "max_gap_s": 1.312,
   "pieces": 19
  },
  {
   "lang": "tr",
   "chars": 25,
   "text": "Göğsümde bir sıkışma var,",
   "first_audio_s": 1.164,
   "total_s": 3.436,
   "audio_s": 2.74,
   "max_gap_s": 0.681,
   "pieces": 15
  },
  {
   "lang": "tr",
   "chars": 56,
   "text": "Nefes almakta zorlanıyorum, özellikle merdiven çıkarken.",
   "first_audio_s": 1.076,
   "total_s": 7.706,
   "audio_s": 6.24,
   "max_gap_s": 2.127,
   "pieces": 33
  },
  {
   "lang": "tr",
   "chars": 17,
   "text": "Hayır doktor bey,",
   "first_audio_s": 1.066,
   "total_s": 3.581,
   "audio_s": 3.02,
   "max_gap_s": 0.875,
   "pieces": 16
  },
  {
   "lang": "tr",
   "chars": 47,
   "text": "Sabahtan beri midem bulanıyor ve başım dönüyor.",
   "first_audio_s": 1.049,
   "total_s": 4.912,
   "audio_s": 4.42,
   "max_gap_s": 1.303,
   "pieces": 23
  },
  {
   "lang": "tr",
   "chars": 49,
   "text": "Düzenli kullandığım bir ilaç yok, alerjim de yok.",
   "first_audio_s": 1.062,
   "total_s": 5.081,
   "audio_s": 3.76,
   "max_gap_s": 1.12,
   "pieces": 21
  },
  {
   "lang": "en",
   "chars": 30,
   "text": "It started last night, doctor.",
   "first_audio_s": 1.061,
   "total_s": 3.388,
   "audio_s": 2.7,
   "max_gap_s": 0.719,
   "pieces": 14
  },
  {
   "lang": "en",
   "chars": 48,
