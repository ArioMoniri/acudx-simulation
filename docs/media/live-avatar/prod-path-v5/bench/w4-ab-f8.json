{
 "rows": [
  {
   "lang": "tr",
   "chars": 25,
   "text": "Dün akşam başladı doktor,",
   "first_audio_s": 1.082,
   "total_s": 3.233,
   "audio_s": 2.82,
   "max_gap_s": 0.512,
   "pieces": 15
  },
  {
   "lang": "tr",
   "chars": 25,
   "text": "Göğsümde bir sıkışma var,",
   "first_audio_s": 1.058,
   "total_s": 2.022,
   "audio_s": 1.7,
   "max_gap_s": 0.269,
   "pieces": 8
  },
  {
   "lang": "tr",
   "chars": 56,
   "text": "Nefes almakta zorlanıyorum, özellikle merdiven çıkarken.",
   "first_audio_s": 1.075,
   "total_s": 4.727,
   "audio_s": 3.92,
   "max_gap_s": 0.91,
   "pieces": 20
  },
  {
   "lang": "tr",
   "chars": 17,
   "text": "Hayır doktor bey,",
   "first_audio_s": 1.079,
   "total_s": 3.292,
   "audio_s": 3.02,
   "max_gap_s": 0.572,
   "pieces": 15
  },
  {
   "lang": "tr",
   "chars": 47,
   "text": "Sabahtan beri midem bulanıyor ve başım dönüyor.",
   "first_audio_s": 1.063,
   "total_s": 3.588,
   "audio_s": 3.1,
   "max_gap_s": 0.631,
   "pieces": 16
  },
  {
   "lang": "tr",
   "chars": 49,
   "text": "Düzenli kullandığım bir ilaç yok, alerjim de yok.",
   "first_audio_s": 1.083,
   "total_s": 6.166,
   "audio_s": 5.44,
   "max_gap_s": 0.781,
   "pieces": 27
  },
  {
   "lang": "en",
   "chars": 30,
   "text": "It started last night, doctor.",
   "first_audio_s": 1.091,
   "total_s": 3.177,
   "audio_s": 2.74,
   "max_gap_s": 0.441,
   "pieces": 14
  },
  {
   "lang": "en",
   "chars": 48,
   "text": "I feel a tight pressure in my chest when I walk.",
