{
 "rows": [
  {
   "lang": "tr",
   "chars": 25,
   "text": "Dün akşam başladı doktor,",
   "first_audio_s": 0.88,
   "total_s": 3.493,
   "audio_s": 3.26,
   "max_gap_s": 0.975,
   "pieces": 18
  },
  {
   "lang": "tr",
   "chars": 25,
   "text": "Göğsümde bir sıkışma var,",
   "first_audio_s": 0.874,
   "total_s": 3.172,
   "audio_s": 2.82,
   "max_gap_s": 0.99,
   "pieces": 14
  },
  {
   "lang": "tr",
   "chars": 56,
   "text": "Nefes almakta zorlanıyorum, özellikle merdiven çıkarken.",
   "first_audio_s": 0.855,
   "total_s": 7.163,
   "audio_s": 6.4,
   "max_gap_s": 1.739,
   "pieces": 31
  },
  {
   "lang": "tr",
   "chars": 17,
   "text": "Hayır doktor bey,",
   "first_audio_s": 0.881,
   "total_s": 3.328,
   "audio_s": 3.02,
   "max_gap_s": 0.883,
   "pieces": 15
  },
  {
   "lang": "tr",
   "chars": 47,
   "text": "Sabahtan beri midem bulanıyor ve başım dönüyor.",
   "first_audio_s": 0.911,
   "total_s": 3.519,
   "audio_s": 3.3,
   "max_gap_s": 0.971,
   "pieces": 16
  },
  {
   "lang": "tr",
   "chars": 49,
   "text": "Düzenli kullandığım bir ilaç yok, alerjim de yok.",
   "first_audio_s": 0.861,
   "total_s": 6.396,
   "audio_s": 5.84,
   "max_gap_s": 1.044,
   "pieces": 29
  },
  {
   "lang": "en",
   "chars": 30,
   "text": "It started last night, doctor.",
   "first_audio_s": 0.868,
   "total_s": 2.062,
   "audio_s": 1.7,
   "max_gap_s": 0.835,
   "pieces": 8
  },
  {
   "lang": "en",
   "chars": 48,
