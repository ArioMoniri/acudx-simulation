# Copy to .env. Only the admin token is required to start; everything else is set in the admin panel.
DOMAIN=
ADMIN_TOKEN=change-me-long-random
AIRGAPPED=false
# Model endpoint (OpenAI-compatible). Leave empty to rely on the on-demand GPU worker.
LLM_PROVIDER=api
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
# Claude (Anthropic): the default model route for every role when set (docs/architecture/20).
# ANTHROPIC_API_KEY is accepted as an alias. Server-side only; never sent to the browser.
ANTHROPIC_KEY=
# On-demand GPU worker (Lambda Cloud)
LAMBDA_KEY=
LAMBDA_SSH_KEY_NAME=
GPU_IDLE_MINUTES=20
# GPU_DAILY_BUDGET_USD=  (unset = no daily cap; idle workers still stop after GPU_IDLE_MINUTES)
