{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Ec2Describe",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeVpcs",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeKeyPairs",
        "ec2:DescribeInstances",
        "ec2:DescribeInstanceTypes",
        "ec2:DescribeAddresses",
        "ec2:DescribeImages"
      ],
      "Resource": "*"
    },
    {
      "Sid": "Ec2CreateTheStack",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateSecurityGroup",
        "ec2:CreateKeyPair",
        "ec2:AllocateAddress",
        "ec2:RunInstances",
        "ec2:CreateTags"
      ],
      "Resource": "*"
    },
    {
      "Sid": "Ec2ChangeOnlyStackTaggedResources",
      "Effect": "Allow",
      "Action": [
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:DeleteSecurityGroup",
        "ec2:TerminateInstances",
        "ec2:AssociateAddress",
        "ec2:ReleaseAddress",
        "ec2:DeleteKeyPair"
      ],
      "Resource": "*",
      "Condition": { "StringLike": { "aws:ResourceTag/acudx:stack": "acudx-*" } }
    },
    {
      "Sid": "Ec2AssociateAddressTargets",
      "Effect": "Allow",
      "Action": "ec2:AssociateAddress",
      "Resource": ["arn:aws:ec2:*:*:instance/*", "arn:aws:ec2:*:*:network-interface/*"]
    },
    {
      "Sid": "UbuntuAmiLookup",
      "Effect": "Allow",
      "Action": "ssm:GetParameters",
      "Resource": "arn:aws:ssm:*::parameter/aws/service/canonical/ubuntu/server/24.04/*"
    },
    {
      "Sid": "StackParametersFromTheOperatorSide",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:PutParameter",
        "ssm:GetParametersByPath",
        "ssm:DeleteParameters"
      ],
      "Resource": ["arn:aws:ssm:*:*:parameter/acudx/*"]
    }
  ]
}
